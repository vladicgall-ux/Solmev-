# Comma-separated list of exchanges to compare.
# Supported: binance, bybit, okx, kucoin, gateio, mexc, bitget
EXCHANGES=binance,bybit,okx,kucoin,gateio,mexc,bitget

# Quote asset all compared pairs must share, so prices are apples-to-apples.
QUOTE_ASSET=USDT

# How often to re-fetch prices from every exchange, in seconds. One HTTP
# request per exchange per scan (public "all tickers" endpoints) — 30s is
# comfortably inside every listed exchange's public rate limit.
POLL_INTERVAL_SEC=30

# Minimum price gap between the cheapest and priciest exchange (in %) for a
# coin to show up in "📊 Топ сейчас" or trigger a Telegram alert.
MIN_SPREAD_PCT=1

# Sanity ceiling: gaps above this are almost always a data artifact (a
# delisted/thin pair, a leveraged-token symbol collision, a wrapped-token
# mismatch) rather than a tradable opportunity, so they're dropped instead
# of shown.
MAX_SPREAD_PCT=50

# Both the cheap side and the expensive side must have at least this much
# 24h quote volume (USD) on their own exchange, or the pair is skipped as
# too illiquid to realistically trade at the quoted price.
MIN_VOLUME_USD=50000

# Don't re-alert on the same coin + buy-exchange + sell-exchange combo
# within this many minutes, so one persistent spread doesn't spam the chat
# on every scan.
ALERT_COOLDOWN_MIN=15

# How many rows the "📊 Топ сейчас" button shows.
TOP_LIST_SIZE=15

# --- Telegram control ---
# Only this one Telegram user id can control the bot; every other chat is
# silently ignored. Without these two set, the bot runs headless and just
# logs opportunities to stdout.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
