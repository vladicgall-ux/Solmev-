# Solana RPC endpoint. Public RPCs rate-limit hard; use a paid provider
# (Helius, Triton, QuickNode) for anything beyond toy testing.
RPC_URL=https://api.mainnet-beta.solana.com

# Base58-encoded secret key of the trading wallet (e.g. output of `solana-keygen`
# or the array from a Phantom export converted to base58). NEVER commit this file.
PRIVATE_KEY=

# Token mints to scan, comma-separated pairs as MINT_A:MINT_B
# Defaults to SOL/USDC and SOL/USDT.
TOKEN_PAIRS=So11111111111111111111111111111111111111:EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v,So11111111111111111111111111111111111111:Es9vMFrzaCERmJfrF4H2FYD4KCoNkY11McCe8BenwNYB

# DEX labels to compare via Jupiter's `dexes` filter. Must match Jupiter's
# program labels exactly (see https://quote-api.jup.ag/v6/program-id-to-label).
DEXES=Raydium,Orca,Meteora,Whirlpool

# Trade size for the base leg, in the input token's smallest unit (lamports for SOL).
# 0.5 SOL default.
TRADE_SIZE_LAMPORTS=500000000

# Minimum net profit (after both swap legs + priority fee + Jito tip) required
# to fire a trade, in basis points of the trade size.
MIN_PROFIT_BPS=15

# Per-leg slippage tolerance passed to Jupiter, in basis points.
SLIPPAGE_BPS=25

# How often to poll for opportunities, in milliseconds.
POLL_INTERVAL_MS=1500

# Hard cap on the priority fee Jupiter may attach PER LEG, in lamports (not
# microLamports). This is a real cost paid every time a bundle lands — keep
# it small relative to TRADE_SIZE_LAMPORTS. 20000 lamports ~= $0.003 at $150/SOL.
PRIORITY_FEE_MAX_LAMPORTS=20000

# Send the two legs as an atomic Jito bundle instead of two independent txs.
# Strongly recommended: without atomicity a failed second leg leaves you
# holding an unwanted position.
JITO_ENABLED=true
JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf
JITO_TIP_LAMPORTS=100000

# When true (default), opportunities are logged but no transaction is sent.
# Flip to false only once you've watched dry-run output and trust the numbers.
DRY_RUN=true

# --- Telegram control (optional) ---
# If TELEGRAM_BOT_TOKEN is set, the bot starts in Telegram-controlled mode:
# it waits idle for /connect <private_key> and /run instead of auto-starting
# with PRIVATE_KEY from this file. Get a token from @BotFather.
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user id (get it from @userinfobot). Only this id can
# issue commands to the bot — every other chat is silently ignored.
TELEGRAM_OWNER_ID=
