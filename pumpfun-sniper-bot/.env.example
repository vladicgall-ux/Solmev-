# Solana RPC endpoint. Use a paid provider (Helius/QuickNode) — public RPC
# will rate-limit you almost immediately at snipe speed.
RPC_URL=https://api.mainnet-beta.solana.com

# Base58 secret key. Only needed for headless CLI mode — in Telegram mode,
# connect via the 🔌 Кошелёк button instead so the key never sits in a config file.
PRIVATE_KEY=

# Trade size as a % of the wallet's CURRENT SOL balance, recomputed before
# every buy — not a fixed SOL amount. Recommended range 5-10. Keep it small;
# pump.fun tokens fail (rug/zero liquidity/dev dump) far more often than
# they 2x. Treat every snipe as money you're fully prepared to lose.
TRADE_SIZE_PCT=7
# Always left unspent as a fee/rent buffer when sizing a trade off balance.
MIN_SOL_RESERVE=0.01

# Off by default: buy any fresh launch regardless of market cap. Set to
# true to only snipe tokens whose launch market cap is under
# MAX_ENTRY_MARKET_CAP_SOL (pump.fun bonding curves start around ~30 SOL
# virtual cap, so this mostly filters out tokens the bot saw late).
MCAP_FILTER_ENABLED=false
MAX_ENTRY_MARKET_CAP_SOL=50

# Exit rules, evaluated against the marketCap ratio vs entry (bonding-curve
# supply is fixed, so marketCap ratio ≈ price ratio).
TAKE_PROFIT_PCT=100
STOP_LOSS_PCT=10

# Cap on how many snipes can be open at once, so one bad batch of launches
# can't spend your whole balance in a few seconds.
MAX_CONCURRENT_POSITIONS=3

SLIPPAGE_PCT=15

# Static priority fee (SOL), used when DYNAMIC_PRIORITY_FEE=false or as a
# fallback if the RPC can't be queried for recent fees.
PRIORITY_FEE_SOL=0.0005

# When true (default), the priority fee is estimated per-trade from recent
# network fees instead of the static value above: aggressive (90th
# percentile) on buys — that's the leg actually racing other snipers —
# and cheap (median) on sells, which aren't a race. Always bounded by
# MIN/MAX below, so it can't run away during a fee spike.
DYNAMIC_PRIORITY_FEE=true
MIN_PRIORITY_FEE_SOL=0.00001
MAX_PRIORITY_FEE_SOL=0.002

# Fast mode (default on) skips the local simulateTransaction check and RPC
# preflight on the BUY leg only, saving a network round trip on the side
# that's actually racing other bots. Sells always simulate. Trade-off: a
# doomed buy (bad slippage, curve already migrated, etc.) can land as a
# failed on-chain tx instead of being caught before sending — you still
# only lose the small base fee, not the trade size, but it's not free.
FAST_MODE=true

# When true (default), logs what it WOULD buy/sell but sends nothing.
DRY_RUN=true

# --- Telegram control (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
