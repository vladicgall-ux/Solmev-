# Solana RPC endpoint. Use a paid provider (Helius/QuickNode) — public RPC
# will rate-limit you almost immediately at snipe speed.
RPC_URL=https://api.mainnet-beta.solana.com

# Base58 secret key. Only needed for headless CLI mode — in Telegram mode,
# connect via /connect instead so the key never sits in a config file.
PRIVATE_KEY=

# SOL spent per snipe. Keep this small — pump.fun tokens fail (rug/zero
# liquidity/dev dump) far more often than they 2x. Treat each snipe as
# money you're fully prepared to lose.
TRADE_SIZE_SOL=0.02

# Only snipe tokens whose market cap at the moment of the launch event is
# below this, in SOL. pump.fun bonding curves start around ~30 SOL virtual
# cap, so this mostly filters out tokens the bot saw late (already pumped
# before we got the event).
MAX_ENTRY_MARKET_CAP_SOL=50

# Exit rules, evaluated against the marketCap ratio vs entry (bonding-curve
# supply is fixed, so marketCap ratio ≈ price ratio).
TAKE_PROFIT_PCT=100
STOP_LOSS_PCT=10

# Cap on how many snipes can be open at once, so one bad batch of launches
# can't spend your whole balance in a few seconds.
MAX_CONCURRENT_POSITIONS=3

SLIPPAGE_PCT=15
PRIORITY_FEE_SOL=0.0005

# When true (default), logs what it WOULD buy/sell but sends nothing.
DRY_RUN=true

# --- Telegram control (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
